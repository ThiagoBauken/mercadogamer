# ============================================
# EASYPANEL - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para configurar cada serviço no Easypanel

# ============================================
# BACKEND API (Node.js + Express + Socket.IO)
# ============================================

# Ambiente
NODE_ENV=production

# Banco de Dados MongoDB
# Formato: mongodb://host:porta
# No Easypanel, use o nome do serviço como host
DATABASE_HOST=mongodb:27017
DATABASE_NAME=mercadogamer

# URLs do Backend
# Use o domínio fornecido pelo Easypanel ou seu domínio customizado
BASE_URL=https://api.seudominio.com
SOCKET_SERVER_URL=https://api.seudominio.com

# URL do Frontend (para CORS e redirects)
FRONTEND_URL=https://seudominio.com
ADMIN_URL=https://admin.seudominio.com

# Diretórios de Upload
UPLOAD_DIR=/app/uploads
IMAGES_DIR=/app/files

# JWT Secret (gere uma chave forte!)
# Exemplo: openssl rand -base64 32
JWT_SECRET=sua-chave-secreta-super-forte-aqui-mude-isso

# Email/SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=noreply@seudominio.com

# MercadoPago
MP_ACCESS_TOKEN=seu-token-do-mercadopago-aqui
MP_PUBLIC_KEY=sua-chave-publica-do-mercadopago

# Stripe
STRIPE_KEY=sk_live_sua-chave-secreta-stripe
STRIPE_PUBLIC_KEY=pk_live_sua-chave-publica-stripe
STRIPE_WEBHOOK_SECRET=whsec_seu-webhook-secret

# NOWPayments (Crypto)
NOWPAYMENTS_API_KEY=sua-api-key-nowpayments
NOWPAYMENTS_IPN_SECRET=seu-ipn-secret-nowpayments

# Firebase Cloud Messaging (Notificações Push)
FCM_SERVER_KEY=sua-chave-fcm-aqui

# Google Maps (opcional)
GOOGLE_MAPS_API_KEY=sua-chave-google-maps

# Logs
DEBUG=api*

# ============================================
# FRONTEND WEB (Marketplace Público)
# ============================================

# Ambiente
NODE_ENV=production

# URLs da API (use o domínio do backend)
NEXT_PUBLIC_SERVER_URL=https://api.seudominio.com/api
NEXT_PUBLIC_SOCKET_URL=https://api.seudominio.com
NEXT_PUBLIC_FILE_URL=https://api.seudominio.com/files

# Domínio do Frontend
NEXT_PUBLIC_DOMAIN=https://seudominio.com

# Chaves Públicas de Pagamento
NEXT_PUBLIC_MP_PUBLIC_KEY=sua-chave-publica-do-mercadopago
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_sua-chave-publica-stripe

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# FRONTEND ADMIN (Painel Administrativo)
# ============================================

# Ambiente
NODE_ENV=production

# URLs da API
NEXT_PUBLIC_SERVER_URL=https://api.seudominio.com/api
NEXT_PUBLIC_SOCKET_URL=https://api.seudominio.com
NEXT_PUBLIC_FILE_URL=https://api.seudominio.com/files

# Domínio do Admin
NEXT_PUBLIC_DOMAIN=https://admin.seudominio.com

# ============================================
# MONGODB (Container Separado)
# ============================================

# Banco de Dados Inicial
MONGO_INITDB_DATABASE=mercadogamer

# Credenciais (RECOMENDADO em produção)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=senha-super-forte-aqui

# ============================================
# OBSERVAÇÕES IMPORTANTES
# ============================================

# 1. NUNCA commitar este arquivo com valores reais!
# 2. Use variáveis de ambiente do Easypanel para cada serviço
# 3. Gere chaves fortes para JWT_SECRET e senhas
# 4. Configure CORS corretamente no backend
# 5. Use HTTPS em produção (Easypanel fornece SSL grátis)
# 6. Configure webhooks dos gateways de pagamento
# 7. Ative MongoDB authentication em produção
# 8. Configure backups automáticos do MongoDB
# 9. Monitore logs através do Easypanel
# 10. Configure domínios customizados após testar com domínio Easypanel

# ============================================
# COMANDOS ÚTEIS
# ============================================

# Gerar JWT Secret:
# openssl rand -base64 32

# Gerar senha forte:
# openssl rand -hex 16

# Verificar variáveis no container:
# env | grep NODE_ENV

# ============================================
# MercadoGamer Backend - Environment Variables
# ============================================

# Node Environment
NODE_ENV=development

# Server Configuration
NODE_PORT=3000
NODE_PORT_HTTPS=443
NODE_PORT_SIO=10111
BASE_URL=http://localhost
PORT=3000

# Database Configuration
DATABASE_HOST=localhost:27017
DATABASE_NAME=mercadogamer
MONGO_USER=
MONGO_PASSWORD=

# Security - CORS
# Lista de origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:3001,http://localhost:4300

# Security - IP Blacklist (opcional)
# BLACKLISTED_IPS=192.168.1.100,10.0.0.5

# File Upload
UPLOAD_DIR=/tmp
IMAGES_DIR=../adm/files

# Email Configuration (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mercadogamer.com

# Payment Gateways

## Mercado Pago
MP_ENV=prod
MP_ACCESS_TOKEN=

## Stripe
STRIPE_ENV=test
STRIPE_TEST_SECRET_KEY=sk_test_YOUR_TEST_KEY
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_YOUR_TEST_KEY
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

## NowPayments (Crypto)
NOWPAYMENTS_ENV=sandbox
NOWPAYMENTS_SANDBOX_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# SMS/Phone (Twilio - opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT Secret
JWT_SECRET=ts$s38*jsjmjnT1

# Debug
DEBUG=api*
